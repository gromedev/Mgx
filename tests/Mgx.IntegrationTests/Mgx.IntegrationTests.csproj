<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 matches src/ and the runtime PowerShell 7.5 actually hosts. This used to say
         net10.0, which meant the suite exercised a runtime the module never ships on.
         RollForward=Major only kicks in when .NET 9 is absent (a machine with just the .NET 10
         SDK); the authoritative run is on real .NET 9 in Docker. -->
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- Not used directly: pins the transitive dependency from Microsoft.PowerShell.SDK
         above 9.0.14, which carries five High advisories (GHSA-37gx-xxp4-5rgx et al.).
         Remove once the PowerShell.SDK reference resolves a patched version on its own. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.19" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mgx.Engine/Mgx.Engine.csproj" />
    <ProjectReference Include="../../src/Mgx.Cmdlets/Mgx.Cmdlets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
