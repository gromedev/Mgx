<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately ahead of src/, which targets net8.0 so the module runs on PowerShell 7.4
         (LTS) and up. This project stays on net10.0 because Microsoft.PowerShell.SDK 7.6.x
         requires it, and referencing a net8.0 project from net10.0 is fine. What that buys is
         the shipped assembly exercised on the newest runtime; the older hosts are covered by
         the `compat` matrix in CI, which imports the module for real under the ends of the
         supported range, 7.4 and 7.6. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- Not used directly: pins the transitive dependency from Microsoft.PowerShell.SDK
         above 10.0.6, which carries five High advisories (GHSA-cvvh-rhrc-wg4q et al.).
         Remove once the PowerShell.SDK reference resolves a patched version on its own. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.4" />
    <!-- Test-only. The resilience bridge disarms the retry handler inside the SDK's own chain,
         and the only honest way to test that is against the real handler rather than a stand-in
         that agrees with us. The version is pinned to what Microsoft.Graph.Authentication 2.36.1
         loads: a different one would measure a handler users do not have. It carries an advisory
         against Microsoft.Kiota.Abstractions, suppressed below. Nothing shipped references Kiota
         - it reaches users through their own installed SDK - so neither the reference nor the
         suppression changes what mgx exposes them to. -->
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.21.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scoped to this one advisory rather than silencing NuGet's audit for the project, so a
         future advisory against anything else still surfaces. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7j59-v9qr-6fq9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mgx.Engine/Mgx.Engine.csproj" />
    <ProjectReference Include="../../src/Mgx.Cmdlets/Mgx.Cmdlets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
